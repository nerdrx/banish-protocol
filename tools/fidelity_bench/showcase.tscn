[sub_resource type="StandardMaterial3D" id="Mat_indicator"]
; The one thing in the room that is on because a machine is running. Amber,
; tiny, and under the glow threshold on purpose — it is a status lamp, not a
; light source, and if it blooms it starts competing with the practicals.
albedo_color = Color(0.08, 0.05, 0.02, 1)
metallic = 0.0
roughness = 0.35
emission_enabled = true
emission = Color(1, 0.58, 0.16, 1)
emission_energy_multiplier = 1.4

[sub_resource type="CameraAttributesPractical" id="CamAttr"]
