[sub_resource type="StandardMaterial3D" id="Mat_wall"]
; Painted bulkhead. Mid-dark rather than near-black: the darkness in this room
; is meant to come from having no light in it, not from the walls being made of
; a material that reflects 1% — which is the mistake that makes a "dark" room
; look like a bug report.
albedo_color = Color(0.295, 0.302, 0.318, 1)
metallic = 0.0
roughness = 0.68

[sub_resource type="StandardMaterial3D" id="Mat_floor"]
; Glossier than the walls, so the practicals get a wet-floor return and SSR has
; something to do. Half the apparent brightness in the reference frames is the
; floor handing the light back.
albedo_color = Color(0.205, 0.212, 0.228, 1)
metallic = 0.05
roughness = 0.29

[sub_resource type="StandardMaterial3D" id="Mat_dark"]
albedo_color = Color(0.105, 0.108, 0.115, 1)
metallic = 0.1
roughness = 0.72

