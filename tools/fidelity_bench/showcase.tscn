; ================================================================ cameras ====

; HERO 1 — "work light through slats in haze". Low and across the room, so the
; lamp's cone is seen almost side-on: the volumetric carries the shaft, the
; slats land on the coolant stack and the wall behind it, and the tripod itself
; is in frame as the visible cause.
[node name="CamSlats" type="Camera3D" parent="."]
position = Vector3(-1.4, 1.25, 2.6)
rotation_degrees = Vector3(-6.0, 22, 0)
fov = 74.0
current = true

; HERO 2 — "screens casting green light". Standing at the end of the console,
; the phosphor doing the lighting, the under-counter strip washing the floor and
; the gold lagging carrying the specular.
[node name="CamScreens" type="Camera3D" parent="."]
position = Vector3(1.05, 1.46, -1.35)
rotation_degrees = Vector3(-7.0, -34.0, 0)
fov = 60.0

; PROP CARD — the work light itself, shot from the lit side so the lens, the
; guard, the cable run, the battery block and the open toolbox are all legible
; in one frame. Looking back INTO the beam on purpose: a practical photographed
; from behind is a silhouette, and a silhouette proves nothing about a prop.
[node name="CamProp" type="Camera3D" parent="."]
position = Vector3(-4.3, 1.15, 1.35)
rotation_degrees = Vector3(-2.9, -59.5, 0)
fov = 55.0
