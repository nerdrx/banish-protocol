[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="players"
3d_physics/layer_3="interact"
3d_physics/layer_4="antivirus"
3d_render/layer_1="default"
3d_render/layer_2="local_hidden"

[physics]

3d/default_gravity=11.0

[rendering]

renderer/rendering_method="forward_plus"
textures/default_filters/anisotropic_filtering_level=3
;; M3.7: TAA instead of MSAA+FXAA. Every expensive buffer in the look-dev stack
;; (SSR, SSIL, volumetric fog) is temporally accumulated and MSAA helps none of
;; them; leaving MSAA on instead produced visible noise in the reflections.
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=true
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
;; One ReflectionProbe per room (ProcLayerBuilder, M4.95), each UPDATE_ONCE. The
;; reflection ATLAS is the VRAM cost, not the probes.
;;
;; THE "+517 MB" NUMBER THAT USED TO BE IN THIS COMMENT WAS STALE AND IS GONE.
;; It was measured against the pre-4.4 cubemap atlas at reflection_size 256. Godot
;; switched the reflection atlas to OCTAHEDRAL layout, which stores one probe as a
;; single 2D map instead of six cube faces; at the 128 px size below a probe costs
;; on the order of 2 MiB rather than the tens of MiB the old figure was divided
;; out of. VRAM is no longer the reason to keep this number small.
;;
;; So the cap doubles, 12 -> 24. Twelve was the maximum room count of one layer,
;; which sounded right and was not: a layer's rooms plus the M6.6 galleries and
;; the fidelity pass's own hero props all want probes, and a probe that loses its
;; atlas slot does not degrade — it stops reflecting, and the room it was filling
;; goes back to emissive-trim-floating-in-black. What DOES still cost is the
;; clustering pass that decides which probes affect which fragment, so this is
;; watched in the perf census rather than raised further "because VRAM is free".
reflections/reflection_atlas/reflection_count=24
;; And a smaller per-probe cubemap: in a near-black game the reflections carry
;; subtle emissive spill, not mirror detail, so 128 holds up where 256 would and
;; recovers most of the atlas VRAM. Halves the atlas footprint.
reflections/reflection_atlas/reflection_size=128
environment/volumetric_fog/volume_size=128
environment/volumetric_fog/volume_depth=192
environment/volumetric_fog/use_filter=1
