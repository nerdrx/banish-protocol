; Engine configuration file.
; NULLVOID — see DESIGN.md

config_version=5

[application]

config/name="BANISH PROTOCOL"
config/description="1-4 player co-op first-person roguelite. You are an invading program descending through the security layers of a rogue AI to steal its data."
run/main_scene="res://src/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/quit_on_go_back=false

[autoload]

A11y="*res://src/core/a11y.gd"
;; PT2 (Screen & Nav). Second in the list on purpose: it sets the window's
;; content scale factor, and every Control in the game lays out against the
;; canvas size that factor decides. Anything built before it would snapshot the
;; wrong geometry.
Screen="*res://src/core/screen_settings.gd"
;; FIDELITY PASS. The renderer quality store (PHOTONICS settings section). Third,
;; beside Screen: it writes RenderingServer state that every later scene renders
;; against, and it must be readable by the first WorldEnvironment that stands up.
;; It touches no gameplay autoload and nothing touches it back.
Photonics="*res://src/fidelity/photonics.gd"
Rng="*res://src/core/rng.gd"
Modules="*res://src/core/modules.gd"
GameState="*res://src/core/game_state.gd"
Net="*res://src/core/net.gd"
Run="*res://src/core/run_state.gd"
NoiseBus="*res://src/core/noise_system.gd"
Props="*res://src/core/prop_state.gd"
Debug="*res://src/core/debug.gd"
SteamHub="*res://src/core/steam_service.gd"
Achievements="*res://src/core/achievements.gd"
;; PT2 (Screen & Nav): the crew's shared memory of the layer, for the minimap.
;; After Run and Net (it listens to both) and after Props, whose request/validate
;; shape it copies.
Cartography="*res://src/core/cartography.gd"
Captions="*res://src/core/caption_bus.gd"
Audio="*res://src/core/audio_service.gd"
Music="*res://src/core/music_director.gd"
Haunt="*res://src/core/haunt_director.gd"
;; M7 (Subroutines & Juice). Both go LAST, and the order between them matters.
;; Fx is a pure presentation service with no dependencies of its own; Subs reads
;; Run, Net, Modules and GameState on load and hands its cast echoes to Fx, so it
;; comes after everything it talks to. Neither is ever consulted by generation —
;; the determinism dump cannot see either of them.
Fx="*res://src/fx/fx.gd"
Subs="*res://src/player/subroutines.gd"
;; M9 (PATCHES). Dead last, and the order is load-bearing: it reads Run, Net,
;; Modules and Rng on load, hands its bursts to Fx and its shells to the same
;; ChecksumBarrier class Subs casts — so everything it consults must already be
;; standing. Nothing consults IT during generation: the placement pass calls a
;; static function on PatchPlacement, and the determinism dump renders LayerGraph,
;; which cannot see this autoload at all.
Patches="*res://src/patches/patches.gd"

[shader_globals]

; SAFETY-CRITICAL (limbo-a11y 01-photosensitivity). Project-wide flash switch read
; by every fragment shader with a temporal-flash term (post_process, crt). 1.0 =
; normal (still inside the unconditional caps compiled into the effects), driven
; toward 0.0 by A11y Reduced Flashing. Declared here so the uniform exists from
; engine start — the A11y autoload only SETS its value, avoiding any load-order
; race between a shader compiling and the switch being registered.
a11y_flash={
"type": "float",
"value": 1.0
}
; PT2 (Screen & Nav). The player's VIGNETTE slider, as a multiplier on whatever
; intensity each surface authored. Declared here for the same reason a11y_flash
; is: post_process.gdshader is instantiated as three separate materials in three
; scenes (menu, procedural layer, greybox), and a global uniform reaches all of
; them from one assignment with no scene surgery. 1.0 = the material's own value;
; the Screen autoload only ever SETS this, so there is no load-order race.
ui_vignette={
"type": "float",
"value": 0.55
}

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=0
gdscript/warnings/unsafe_call_argument=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

