[gd_scene load_steps=14 format=3]

; CRT LIGHT-CAST RETROFIT — A/B, one frame.
;
; LEFT  : emissive-only. What the game ships today (M4.8 command terminals).
; RIGHT : the same terminal plus a textured AreaLight3D sized to its own glass.
;
; The two halves are separated by a full-height divider so neither side can
; borrow a single photon from the other, and everything else in the two bays is
; IDENTICAL — same desk, same keyboard, same card stack, same MLI-lagged pipe on
; the wall, same distances. There are no other lights in the scene at all. Every
; difference you can see between the halves is the retrofit.
;
; Watch three things specifically, because they are the three things emissive
; can never do:
;   1. the DESK in front of the tube, and the keyboard on it;
;   2. the specular on the gold lagging — an emissive quad does not appear in a
;      reflection the way a light does, so the right-hand pipe has a green
;      rectangle on it and the left-hand one has almost nothing;
;   3. the wall ABOVE each hood. The hood shades the cast, so the right side has
;      a hard-edged pool with the hood's own shadow line in it, which is the
;      detail that reads as "a monitor is on in here" from the corridor outside.
;
; Shoot it with:
;   tools/fidelity_bench/shoot.sh \
;       res://assets/props/fidelity/crt_lightcast_ab.tscn <out>.png 1920x1080 200 Cam

[ext_resource type="Environment" path="res://src/world/layer_environment.tres" id="1_env"]
[ext_resource type="PackedScene" path="res://assets/props/fidelity/crt_terminal.tscn" id="2_term"]
[ext_resource type="Material" path="res://assets/materials/fidelity/mat_brushed_steel.tres" id="3_steel"]
[ext_resource type="Material" path="res://assets/materials/fidelity/mat_mli_gold.tres" id="4_mli"]
[ext_resource type="Material" path="res://assets/materials/fidelity/mat_hazard_band.tres" id="5_hazard"]

[sub_resource type="StandardMaterial3D" id="Mat_room"]
albedo_color = Color(0.365, 0.375, 0.395, 1)
metallic = 0.0
roughness = 0.66

[sub_resource type="StandardMaterial3D" id="Mat_floor"]
albedo_color = Color(0.275, 0.285, 0.305, 1)
metallic = 0.0
roughness = 0.35

[sub_resource type="BoxMesh" id="Box_floor"]
size = Vector3(9, 0.3, 7)

[sub_resource type="BoxMesh" id="Box_backwall"]
size = Vector3(9, 3.4, 0.3)

[sub_resource type="BoxMesh" id="Box_divider"]
