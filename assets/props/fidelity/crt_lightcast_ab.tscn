[sub_resource type="BoxMesh" id="Box_deskbody"]
size = Vector3(1.78, 0.72, 0.7)

[sub_resource type="CameraAttributesPractical" id="CamAttr"]
exposure_multiplier = 1.0

[node name="CrtLightCastAB" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = ExtResource("1_env")
camera_attributes = SubResource("CamAttr")

