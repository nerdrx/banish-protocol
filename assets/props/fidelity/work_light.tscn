rotation_degrees = Vector3(28, 0, 0)
mesh = SubResource("Mesh_gland")
surface_material_override/0 = SubResource("Mat_dark")

; The practical itself. Sits just behind the lens plane so the guard is inside
; its own cone. Everything below is overwritten by the script's exports; the
; values are the defaults so the scene reads standalone.
[node name="Spot" type="SpotLight3D" parent="Column/Head"]
position = Vector3(0, 0, -0.04)
light_color = Color(1, 0.7776, 0.5504, 1)
light_energy = 9.0
light_specular = 1.0
light_volumetric_fog_energy = 1.6
shadow_enabled = true
shadow_bias = 0.028
shadow_normal_bias = 1.2
shadow_blur = 1.3
spot_range = 16.0
spot_angle = 34.0
spot_angle_attenuation = 0.85
spot_attenuation = 0.85
light_projector = ExtResource("4_gobo")
