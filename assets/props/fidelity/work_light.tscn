[sub_resource type="StandardMaterial3D" id="Mat_lens"]
; Local to scene: two work lights at different colour temperatures in one room
; would otherwise share one lens material and both take the last one written.
resource_local_to_scene = true
; The visible source. Albedo is a dark smoked glass, not white: an unlit work
; lamp with a white lens looks like a headlight sticker, and this lens spends
; plenty of frames unlit (the prop is placed in rooms whose power is out).
; Emission is overwritten per-frame by the script to match the colour
; temperature — a practical whose glass disagrees with its own beam is the
; giveaway that the fixture is decoration in front of a spotlight.
albedo_color = Color(0.085, 0.081, 0.072, 1)
metallic = 0.0
roughness = 0.14
emission_enabled = true
emission = Color(1, 0.78, 0.52, 1)
emission_energy_multiplier = 2.1

[sub_resource type="StandardMaterial3D" id="Mat_dark"]
; Cast/painted housing back and heat fins. Deliberately a different, duller
; material to the brushed body: a fixture assembled from one material is a
; fixture nobody assembled.
albedo_color = Color(0.075, 0.077, 0.081, 1)
metallic = 0.15
roughness = 0.68

[node name="WorkLight" type="Node3D"]
script = ExtResource("1_script")

