; --------------------------------------------------------------------- head --
; rotation_degrees is overwritten by the script from head_pitch_deg/head_yaw_deg.
; The values here are the defaults, so the scene still reads correctly if it is
; ever opened without running.

[node name="Head" type="Node3D" parent="Column"]
