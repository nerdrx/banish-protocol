[gd_resource type="ShaderMaterial" load_steps=8 format=3]

; M_PanelDark (PBR) — the wall the player stands 30 cm from.
;
; Tiling 2 m, so a 4 m kit module shows a 2 x 2 field of 0.5 m plates and a run
; of five identical modules is one continuous panel field rather than the same
; stamp five times. That comes free with the world-space projection in
; nv_surface_pbr.gdshader and it is the single biggest anti-repetition measure
; in the kit.
;
; smudge_amount is the reason to look at this material twice. It puts a
; polished, fractionally darker band across every wall at 1.25 m — exactly the
; height a shoulder brushes past — and blends it with the macro field so it
; appears in some places and not others. Nobody notices it; everybody responds
; to it.

[ext_resource type="Shader" path="res://src/shaders/nv_surface_pbr.gdshader" id="1"]
[ext_resource type="Texture2D" path="res://assets/pbr/wall_panel_albedo.png" id="2"]
