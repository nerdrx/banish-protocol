[gd_resource type="ShaderMaterial" load_steps=7 format=3]

; M_Grate (parallax occlusion) — the one hero surface that pays for a ray march.
;
; pom_depth is 40 mm because the FLOOR_2x2_GRATE module is 40 mm deep. That is
; not an art number to taste: when the parallax depth and the mesh depth agree,
; the illusion holds at the module's own edge, where the player can see the real
; silhouette and the faked interior at the same time. Set it to 80 mm because it
; "looks deeper" and the grate visibly detaches from its own frame.

[ext_resource type="Shader" path="res://src/shaders/nv_surface_pom.gdshader" id="1"]
