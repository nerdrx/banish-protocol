[gd_resource type="ShaderMaterial" load_steps=8 format=3]

; M_Grate (PBR) — walkway grating and vent louvres.
;
; The height field behind this set is unusually deep and clean because it is
; also the parallax-occlusion hero surface (see nv_surface_pom.gdshader). Even
; with POM off, the albedo goes near-zero between the bars, so a grate reads as
; holes rather than as a pattern painted on a plate — which matters because the
; grates are the only place in the kit where a beam shines THROUGH the floor.

[ext_resource type="Shader" path="res://src/shaders/nv_surface_pbr.gdshader" id="1"]
[ext_resource type="Texture2D" path="res://assets/pbr/grate_albedo.png" id="2"]
