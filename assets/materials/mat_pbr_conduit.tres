[gd_resource type="ShaderMaterial" load_steps=8 format=3]

; M_Conduit (PBR) — cables, pipes, ducting, junction cans.
;
; These are smooth-shaded cylinders, which is the one shape a two-plane world
; projection handles badly: the seam where the dominant axis flips runs straight
; down the pipe. It is hidden by tiling this set at 0.7 m (so the seam has no
; large feature to break) and by leaning on the detail octave, which is
; isotropic and does not care about the projection.

[ext_resource type="Shader" path="res://src/shaders/nv_surface_pbr.gdshader" id="1"]
