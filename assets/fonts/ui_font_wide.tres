[gd_resource type="FontVariation" load_steps=2 format=3]

; Letterspaced variant for labels and buttons. Tracking is most of what separates
; "sci-fi UI" from "default engine UI".

[ext_resource type="Font" path="res://assets/fonts/ui_font.tres" id="1_base"]

[resource]
resource_name = "UIFontWide"
base_font = ExtResource("1_base")
spacing_glyph = 4
spacing_space = 2
